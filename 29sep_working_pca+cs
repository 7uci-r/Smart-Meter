/* main.c
 *
 * Single-phase focused Modbus poller for Enersol MFR series (minimal prints)
 * with PCA + FFT-based spectral sparsification (quantized int16 coefficients).
 *
 * Requirements:
 *  - Your existing CubeMX code and UART handles (huart2/huart3).
 *  - fft_analysis.h / fft_analysis.c providing:
 *      void fft_init(void);
 *      void fft_forward_packed(const float *time_in, float *packed_out);
 *      void fft_inverse_packed(const float *packed_in, float *time_out);
 *      #define FFT_LEN  (e.g. 64)
 */

