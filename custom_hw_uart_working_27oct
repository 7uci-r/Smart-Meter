/* Private defines -----------------------------------------------------------*/
#define PACKET_LEN     40U
#define UART_RX_TIMEOUT_MS 3000U

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart2; // meter UART (RX)
UART_HandleTypeDef huart3; // debug UART (TX)
uint8_t rx_buffer[PACKET_LEN];

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
static void MX_USART3_UART_Init(void);
void Error_Handler(void);

/* Retarget printf to huart3 for debug output */
int __io_putchar(int ch)
{
    uint8_t c = (uint8_t)ch;
    HAL_UART_Transmit(&huart3, &c, 1, HAL_MAX_DELAY);
    return ch;
}

/* CRC8 (MSB-first, poly 0x07) - same algorithm as your Linux code */
uint8_t crc8(const uint8_t *data, size_t len)
{
    uint8_t crc = 0x00;
    for (size_t i = 0; i < len; ++i) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; ++j) {
            if (crc & 0x80) crc = (crc << 1) ^ 0x07;
            else crc <<= 1;
        }
    }
    return crc;
}

/* Pack bytes big-endian into unsigned 32-bit */
uint32_t PackDataBE(const uint8_t *arr, uint8_t length)
{
    uint32_t val = 0;
    for (uint8_t i = 0; i < length; ++i) {
        val = (val << 8) | (uint32_t)arr[i];
    }
    return val;
}

/* Hex dump helper (prints to huart3) */
void hex_dump(const uint8_t *buf, size_t len)
{
    for (size_t i = 0; i < len; ++i) {
        printf("%02X ", buf[i]);
        if ((i & 15) == 15) printf("\r\n");
    }
    printf("\r\n");
}

/* Decode and print parsed values (raw integers; apply scaling later if needed) */
void decode_and_print(const uint8_t *buf)
{
    uint32_t voltage        = PackDataBE(&buf[0], 4);
    uint32_t current        = PackDataBE(&buf[4], 4);
    uint32_t real_power     = PackDataBE(&buf[8], 4);
    uint32_t reactive_power = PackDataBE(&buf[12],4);
    uint32_t apparent_power = PackDataBE(&buf[16],4);
    uint16_t inst_pf        = (uint16_t)PackDataBE(&buf[20], 2);
    uint8_t  pf_sign        = buf[22];
    uint16_t inst_freq      = (uint16_t)PackDataBE(&buf[23], 2);
    uint32_t real_kwh       = PackDataBE(&buf[25], 4);
    uint32_t real_kvah      = PackDataBE(&buf[29], 4);

    uint8_t Date = buf[33];
    uint8_t Month = buf[34];
    uint8_t Year = buf[35];
    uint8_t Hour = buf[36];
    uint8_t Min = buf[37];
    uint8_t Sec = buf[38];

    printf("----- Parsed Values -----\r\n");
    printf("Voltage        : %lu\r\n", (unsigned long)voltage);
    printf("Current        : %lu\r\n", (unsigned long)current);
    printf("Real Power     : %lu\r\n", (unsigned long)real_power);
    printf("Reactive Power : %lu\r\n", (unsigned long)reactive_power);
    printf("Apparent Power : %lu\r\n", (unsigned long)apparent_power);
    printf("InstPF         : %u\r\n", (unsigned int)inst_pf);
    printf("PFSign         : %u\r\n", (unsigned int)pf_sign);
    printf("Frequency      : %u\r\n", (unsigned int)inst_freq);
    printf("Real KWH       : %lu\r\n", (unsigned long)real_kwh);
    printf("Real KVAH      : %lu\r\n", (unsigned long)real_kvah);
    printf("RTC            : %02u/%02u/%02u  %02u:%02u:%02u\r\n",
           Date, Month, Year, Hour, Min, Sec);
    printf("--------------------------\r\n\r\n");
}

/* Application entry point */
int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_USART3_UART_Init(); // debug first so printf works early
    MX_USART2_UART_Init(); // meter UART

    printf("\r\n=== Smart Meter UART Reader (STM32F4) ===\r\n");
    printf("USART2: 38400 baud (RX)  |  USART3: 115200 baud (debug)\r\n");
    printf("Expecting %u-byte frames. Timeout per frame: %u ms\r\n\r\n", (unsigned)PACKET_LEN, (unsigned)UART_RX_TIMEOUT_MS);

    while (1)
    {
        /* Blocking receive PACKET_LEN bytes with timeout */
        HAL_StatusTypeDef r = HAL_UART_Receive(&huart2, rx_buffer, PACKET_LEN, UART_RX_TIMEOUT_MS);
        if (r == HAL_OK)
        {
            printf("[INFO] Received %u bytes. Dump:\r\n", (unsigned)PACKET_LEN);
            hex_dump(rx_buffer, PACKET_LEN);

            uint8_t computed = crc8(rx_buffer, PACKET_LEN - 1);
            uint8_t received = rx_buffer[PACKET_LEN - 1];

            if (computed == received)
            {
                printf("[INFO] CRC OK (0x%02X)\r\n", computed);
                decode_and_print(rx_buffer);
            }
            else
            {
                printf("[ERROR] CRC mismatch. Computed=0x%02X Received=0x%02X\r\n", computed, received);
                printf("[DEBUG] Dump of frame with CRC:\r\n");
                hex_dump(rx_buffer, PACKET_LEN);
            }
        }
        else if (r == HAL_TIMEOUT)
        {
            printf("[WARN] UART receive timeout (%u ms). No full packet.\r\n", (unsigned)UART_RX_TIMEOUT_MS);
        }
        else
        {
            printf("[ERROR] HAL_UART_Receive returned %d\r\n", (int)r);
            /* optional: try re-initializing UART or handle error */
            HAL_Delay(500);
        }

        /* small delay to avoid spamming if meter is continuous */
        HAL_Delay(50);
    }
}

